# ============================================================
# Taasha Backend Environment Configuration
# ============================================================

# Server Port (Auto-assigned on Render/Railway)
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------
# 1. LOCAL DEVELOPMENT (Default: SQLite - Zero setup needed!)
# ------------------------------------------------------------
DATABASE_URL="file:./dev.db"
CLIENT_URL="http://localhost:5173"

# ------------------------------------------------------------
# 2. LIVE PRODUCTION DEPLOYMENT (Free Cloud Database)
# ------------------------------------------------------------
# For free live hosting, get a free PostgreSQL database from:
# - Neon.tech (https://neon.tech) - 0.5 GB free serverless Postgres
# - Supabase (https://supabase.com) - 500 MB free Postgres DB
#
# When deploying to Render / Railway, simply paste your connection string:
# DATABASE_URL="postgresql://user:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# CLIENT_URL="https://your-frontend.vercel.app"
#
# Note: The server automatically detects 'postgresql://' and switches Prisma provider!
