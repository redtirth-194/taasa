{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "include": [
    "CMS/src/**/*",
    "CMS/src/*",
    "SERVER/src/**/*",
    "**/*.js",
    "**/*.jsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
